{
  "name": "phosphor-cam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && bun --bun vite build",
    "android:dev": "adb reverse tcp:5173 tcp:5173 && CAPACITOR_DEV_SERVER_URL=http://localhost:5173 bunx cap run android",
    "android:sync": "bun run build && bunx cap sync android",
    "android:run": "bun run android:sync && bunx cap run android",
    "android:open": "bunx cap open android",
    "android:release": "bun run android:sync && cd android && sh ./release-apk.sh",
    "start": "vite start",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "oxfmt \"**/*.{js,jsx,ts,tsx,json,md,mdx,css}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,css}\"",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,mdx,css}": [
      "oxfmt"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.6.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.8"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
